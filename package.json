{
  "name": "letsseeeify",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev -w @letsseeeify/web",
    "build": "npm run build -w @letsseeeify/web",
    "start": "npm run start -w @letsseeeify/web",
    "typecheck": "npm run typecheck -w @letsseeeify/web",
    "lint": "eslint",
    "test": "npm run test --workspaces --if-present --",
    "test:e2e": "npm run test:e2e -w @letsseeeify/web",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "mobile": "npm --prefix apps/mobile run start"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "geist": "^1.7.2"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}
