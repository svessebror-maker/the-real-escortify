# Copy to .env.local and fill in. Never commit real values.
# Only NEXT_PUBLIC_* values are sent to the browser; everything else is server-only.

# Set to 1 to let a production build start while core variables are missing
# (public landing-page preview before the auth phase). Never set it once
# sign-in exists.
LETSSEEEIFY_PREVIEW=

# Optional link to a hosted Android test build, shown on the home page.
NEXT_PUBLIC_ANDROID_APK_URL=

# --- Core (required from the auth phase onward) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ES256 (P-256) private JWK, as single-line JSON with kid, that signs
# short-lived Supabase access tokens. Startup checks that it can sign.
# See docs/build-plan.md, Step 7. Generate with:
#   npx supabase gen signing-key --algorithm ES256
# then import it into the Supabase project as a JWT signing key.
SUPABASE_JWT_SIGNING_KEY=
STYTCH_PROJECT_ID=
STYTCH_SECRET=
NEXT_PUBLIC_STYTCH_PUBLIC_TOKEN=
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Optional until their phase ---
STYTCH_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
